# Keep host build output out of the image build. Host obj/ and bin/ contain
# project.assets.json files with Windows package paths that break restore/publish in the container.
**/bin
**/obj
**/node_modules
web/dist
**/TestResults

# Never send secrets or VCS data to the Docker daemon
.git
**/.env
**/.env.*

# Not needed to build the API and Worker images
tests
docs
.github
.vs
.vscode
.idea
**/*.log
